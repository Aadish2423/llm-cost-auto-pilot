# Copy this file to `.env` and fill in the keys you actually have.
# Never commit the real `.env` file (it's already in .gitignore).

# Required for the Gemini provider (you have this one)
GEMINI_API_KEY=

# Free-tier providers — sign up at console.groq.com / api.together.ai for a
# key, no payment required to get started
GROQ_API_KEY=
TOGETHER_API_KEY=

# Optional — adapters are coded but dormant until you add a paid key here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — only needed once Ollama is installed locally
OLLAMA_HOST=http://localhost:11434
